# Signs JWT sessions and report HMACs. Required: the app refuses to start if this is
# empty or the built-in placeholder, unless DEMO_MODE=true.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Set to true only for a throwaway demo: allows the placeholder SECRET_KEY (forgeable tokens).
DEMO_MODE=false
XAI_API_KEY=
# Optional. Enables SpaceXAI (xAI grok-4.6) investigator briefings.
# Without it, DeepTrace writes a local forensic note from the ensemble signals.
